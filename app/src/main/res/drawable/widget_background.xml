<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 小组件受 RemoteViews 限制无法做实时模糊，这里用浅色渐变 + 白色描边
         呼应主界面的玻璃质感。 -->
    <gradient
        android:angle="270"
        android:startColor="#FDF7F2"
        android:endColor="#F1E2D8"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#B3FFFFFF" />
    <corners android:radius="20dp" />
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />
</shape>

